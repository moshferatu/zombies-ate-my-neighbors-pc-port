$82:90F7  terrain_blocked_wide # ...and the same again for a big figure
$80:B422  terrain_out_of_bounds # X,Y = the point; carry set = off the map
$80:AE43  tile_attr_test       # LDA [$BA],Y : LSR : BCS -- bit 0 is solid
$80:AD1C  tilemap_tile_addr    # X,Y = tile col,row -> A = the $7F tilemap address
$80:ADC8  tile_attrs_at_pixel  # X,Y = a pixel -> A = that tile's attribute word
