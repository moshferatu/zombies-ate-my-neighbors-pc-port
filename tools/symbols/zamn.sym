# --- Code: the threads a level record starts ---------------------------------
# $9F:8002 is a table of 56 level-record bases, indexed level*2 at $80:886D.
# Two fields of that record name threads, and `tools/levelthreads.py` walks
# them. None of these is callable -- the scheduler resumes a thread by RTL --
# so they are in THREAD_BODIES, not the ranking. Every one of them reaches
# `JSL $808353 thread_yield` within $C5 bytes, which is what says it is a
# thread and not mis-parsed data.
$9F:8002  level_record_table   # level*2 -> the level's record base in bank $9F
# Record offset $18/$1A: one far entry, spawned at $80:8774. All five animate
# the palette shadow that $82:8138 palette_copy_a fills ($7E:5508 / $7E:5708).
$80:A0AD  level_pal_rotate     # 17 levels use $A0EF; this one, 9. $7E:5728 indexes a
                              # 6-word rotation of $7E:549A into $7E:569A
$80:A0EF  level_pal_green      # masks #$FC1F and cycles green in $7E:54DC / $7E:56DC
$80:A137  level_pal_table      # walks $80:A182, 16 bytes a step, into $7E:5508,X
$80:A222  level_pal_rotate_b   # the $A0AD idiom with an 8-tick reload; 3 levels
$80:A264  level_pal_a264       # 1 level (52)
# Record offset $3C: an eight-byte (entry far, parameter far) list, spawned at
# $80:87FB and stopping at a zero entry. A body may appear more than once in
# one level with different parameters.
$82:D7CF  level_tile_anim      # 21 levels: 8 animation channels, each a script of
                              # (tile, delay) at [$00]; sets $1F56 and queues $D88C
$82:D88C  level_tile_anim_job  # the vblank job it queues -- $2115 and the upload
$82:AB95  level_script         # 19 levels: reads its parameter through [$00]
$82:9569  level_intro_9569     # 3 levels: adds #$0028 to $00DE, then a palette load
$82:873C  level_intro_873c     # 2 levels: the same with #$0018 and $94:FFAB
$83:AD33  level_intro_ad33     # 2 levels: JSR $83:AAB2, then the $9569 idiom
$82:A8BB  level_thread_a8bb    # 4 uses; falls into the same body as...
$82:A8C3  level_thread_a8c3    # ...this, a second entry, 3 uses -- both yield at $82:A8EB
$82:DB46  victim_list_parse    # +$1E victim list -> victim_x/_y/_count arrays
$80:C9A5  object_list_parse    # +$20 object list -> object_x/_y/_type arrays
$80:C9E3  object_spawn         # one object -> a display record, from its type
$80:CA30  object_type_to_id    # 30 words: object type -> collision id
$80:CA6C  object_type_to_meta  # 30 words: object type -> metasprite in bank $8F

