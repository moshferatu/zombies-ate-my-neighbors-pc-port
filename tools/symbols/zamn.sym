# ZAMN symbols — fed to zamn_disasm with -s. Everything here was established
# from traced execution (see docs/frame-skeleton.md and docs/wram-map.md),
# not guessed. Add a name only once the evidence is in a trace or listing.
#
# Format: "$BB:AAAA name" for ROM code (canonical $80-$9F FastROM bank),
#         "$00AAAA name" for a WRAM/direct-page variable.

# --- Direct page: scheduler and NMI state ------------------------------------
$000004  nmi_saved_sp          # SP of the interrupted thread, saved on NMI entry
$000008  sched_cur_task        # index (x2) of the running thread
$00000C  vbl_queue_a_count     # entries live in vbl_queue_a
$00000E  vbl_queue_b_count     # entries live in vbl_queue_b
$000010  vbl_queue_remaining   # countdown used while dispatching a queue
$000012  vbl_queue_index       # slot index of the job currently dispatched
$000014  nmi_flags             # bit 15 = NMI already running (re-entrancy guard)
$000016  nmi_frame_counter     # incremented once per NMI
$00001E  apu_seq               # 1 byte: the counter $80:CCC8 puts on $2143 and waits for
$000020  sched_tick            # 32-bit at $20/$22, bumped once per scheduler pass
$000026  render_flags          # bit 6 clear = flush the VRAM upload queue
$00006E  joy1_raw              # $4218 as read this frame
$000070  joy2_raw              # $421A
$000072  joy1_dir              # joy1 d-pad nibble mapped through dir_table, and
                               # the code is the direction x 2: $02 up, $04
                               # up-right, $06 right, $08 down-right, $0A down,
                               # $0C down-left, $0E left, $10 up-left, 0 none.
                               # $82:B7FC's 9 (dx,dy) pairs are what name them
$000074  joy2_dir
$0000CE  vram_queue_count      # bytes (entries x2) queued in the VRAM upload list

# --- Thread scheduler tables -------------------------------------------------
$001180  thread_wait           # 24 x u16: bit15 = live, low bits = ticks to wait
$0011B0  thread_sp             # 24 x u16: saved stack pointer per thread
$001300  thread_handler        # 24 x u16: callback address, set by $80:8475
$001330  thread_handler_bank   # 24 x u16: ...and its bank; both zero = none

# --- Vblank job queues -------------------------------------------------------
$0012A0  vbl_queue_a           # 16 x {u16 addr-1, u8 bank, u8 pad}, run in forced blank
$0012E0  vbl_queue_b           # 8 x {u16 addr-1, u8 bank, u8 pad}, run after blanking ends

# --- PPU shadow state --------------------------------------------------------
$001360  bg_scroll_shadow      # 12 bytes: BG1H,BG1V..BG4V, written twice each
$00136C  brightness_shadow     # restored into INIDISP at the end of NMI
$0013BE  oam_buffer            # 544 bytes DMA'd to OAMDATA every frame
$005628  cgram_buffer          # 128 bytes DMA'd to CGDATA

# --- Sprite build scratch (direct page) --------------------------------------
$00007C  sprite_upload_count   # bytes (entries x2) queued for sprite_upload_flush
$00007E  sprite_frame_base     # $7E/$80: address/bank of the frame array = $84:8000
$000086  sprite_pieces_left    # metasprite pieces still to emit
$000088  oam_index             # byte offset of the next free oam_buffer entry
$00008A  sprite_meta_ptr       # $8A/$8C: 24-bit pointer into the piece array
$00008E  sprite_origin_x       # actor position, camera already subtracted
$000090  sprite_origin_y
$000092  sprite_attr_or        # OAM attribute bits the actor forces on
$000096  sprite_attr_and       # mask applied to each piece's attribute word
$00009A  oam_pass_cursor       # byte index into visible_actors the draw pass is at
$00009C  visible_actor_count   # bytes (entries x2) live in visible_actors
$00009E  sprite_lru_slot       # x2; the cache slot evicted next
$0000A0  sprite_tick           # sched_tick snapshot stamped into sprite_slot_tick

# --- Sprite display list (32 x 20-byte records; see src/port/oam.h) ----------
$00185E  actor_slots           # 32 records of $14 bytes, chained by +$12
$001B5E  actor_list_head       # offset of the first live record, or 0
$001B64  sprite_pass_phase     # $80:BDDE stamps it per pass from a 4-entry table
$001B6A  camera_x              # world coordinate of the top-left of the screen
$001B6C  camera_y

# --- Sprite frame cache (128 slots of 16x16) ---------------------------------
$00137E  visible_actors        # up to 32 x u16: the records this frame draws
$0015DE  sprite_upload_src     # queued upload: source address
$00165E  sprite_upload_bank
$0016DE  sprite_upload_dest    # VRAM word address
$00175E  sprite_slot_tick      # 128 x u16: last tick each slot was drawn at (LRU key)
$002128  frame_slot            # 4096 x u16: slot x2 holding this frame, or negative
$004128  slot_frame            # 128 x u16: the reverse map, used to evict

# --- VRAM upload queue (parallel arrays, vram_queue_count entries) -----------
$001B84  vram_queue_src
$001BB4  vram_queue_bank
$001BE4  vram_queue_dest       # VRAM word address
$001C14  vram_queue_vmain      # VMAIN increment mode
$001C44  vram_queue_size

# --- Background DMA queue (a second one; 32 entries, see src/port/bossbg.h) ---
$001D54  bg_dma_cursor         # entry count already doubled; $82:81C9 zeroes it
$001D56  bg_dma_src
$001D96  bg_dma_bank
$001DD6  bg_dma_len            # bytes, i.e. tiles x 2
$001E16  bg_dma_dest           # VRAM word address
$005736  boss_bg_stage         # 560 bytes: one mirrored figure, built per frame

# --- The big figure's position (not an actor record; 8 writers in banks 82/83) -
$001E62  boss_x                # top centre of a footprint 36 wide, about 20 tall
$001E64  boss_y
$001E66  boss_draw_dx          # $82:892E derives these two from the frame table,
$001E68  boss_draw_dy          # negating dx when the facing flag $36 is negative

# --- LZSS decompressor -------------------------------------------------------
$006F00  lzss_ring             # 4 KB sliding window, prefilled with $20

# --- Actor/victim/object placement (built at level load) ---------------------
$001D50  victim_gate           # constant $0010; victim index must be <= this
$001EC4  object_state          # per-object, stride 2; $C000 = end sentinel
$001F0A  object_type           # per-object type byte, stride 2
$006D02  object_x              # per-object X, stride 2
$006D48  object_y              # per-object Y, stride 2
$006DF4  victim_x              # per-victim X, stride 4
$006DF6  victim_y              # per-victim Y, stride 4
$006E30  victim_count          # victims kept by victim_list_parse

# --- Per-player arrays (2 entries of one word each, indexed by player x2) -----
# Seeded together by $80:8874, which takes the same doubled index.
$001CB8  player_health         # 10 at level start, stepped by $80:D03C; a zombie's touch takes
                               # one, and $80:EB2F refuses a first-aid kit while it is still 10
$001CBC  player_weapon         # seeded to 0; the index $80:D219 looks a table up by
$001CCC  player_inventory      # 2 x 14 BCD counters, stride $20; bases at $80:EAA4
$001CC0  player_item           # the selected *item*, seeded to 7; the pair of player_weapon
$001D0C  player_items          # 2 x 12 BCD counters, stride $20; bases at $80:D1E6

# --- The score (2 slots of one 32-bit BCD counter each, stride 4) -------------
$001E72  player_score          # added to by $80:C7EB/$80:C801; read by the HUD at $80:C0CF
$001E84  score_slot_side       # 2 x u16: the side (0 or 2) owning each score slot

# --- Code: boot --------------------------------------------------------------
$80:80AE  reset_entry          # the RESET vector; switches to native mode, JMLs to bank $80
$80:80C1  reset_clear          # its WRAM clear, both banks by MVN; port/sched.h
$80:80B6  reset_main
$80:8002  init_ppu_regs        # blanks the screen and clears every PPU/DMA register

# --- Code: NMI ---------------------------------------------------------------
$80:816C  nmi_entry            # the NMI vector; trampolines through [$0000]
$80:8179  nmi_main
$80:8199  nmi_stack            # after the blank: park S in $04, move to NMI's stack
$80:81BB  nmi_input            # after the auto-read wait: both pads, raw and as directions
$80:81E4  nmi_leave            # after queue B: the rng tick, S back, the pulls, RTL

# --- Code: cooperative thread scheduler --------------------------------------
$80:825E  thread_spawn         # A:Y = far entry; builds the nine-byte parked frame a
                               # brand-new thread resumes through, and copies the caller's
                               # first five direct-page words onto the new thread's page
$80:830E  thread_sp_table      # 24 x u16: the stack pointer each slot starts at
$002002  thread_entry         # 24 x u16: what each slot was spawned as, minus one
$002032  thread_entry_bank
$000006  thread_count         # live threads; $80:8271 is the only writer traced
$80:8353  thread_yield         # A = ticks to sleep; returns when the wait expires
$80:8371  scheduler_idle       # WAI, then per-frame housekeeping, then re-scan
$80:8372  sched_wake           # the instruction after the WAI: tick, and the stack to $125F
$80:8380  sched_rescan         # JSR thread_tick_waits, then the scan from slot 0
$80:8398  thread_tick_waits    # decrement every live thread's wait counter
$80:833E  thread_exit          # where a thread's own RTL lands; frees the slot
$80:8475  thread_set_handler   # A = handler address, Y = bank; stores at sched_cur_task
$80:8480  thread_call_handler  # X = slot x2, Y = argument; RTLs into that thread's handler
$80:82DE  thread_dp_table      # 24 x u16: each thread's direct page, $0100..$0C80

# --- Code: vblank job queues -------------------------------------------------
$80:83AE  vbl_queue_a_add
$80:83D5  vbl_queue_a_remove
$80:83E0  vbl_queue_a_run
$80:8401  vbl_queue_a_resume   # where a queue A job's RTL comes back to; C set keeps it
$80:8418  vbl_queue_b_add
$80:843D  vbl_queue_b_run
$80:845E  vbl_queue_b_resume   # the same, for queue B

# --- Code: screen ------------------------------------------------------------
$80:891A  fade_in              # ramps brightness_shadow 0->15, yielding each step

# --- Code: graphics transfer -------------------------------------------------
$80:9E7B  vram_queue_flush     # drains the VRAM upload list via DMA, once per NMI
$80:C872  dma_to_cgram         # A=bank, X=source, Y=length -> CGDATA from index 0
$80:C8B8  dma_to_vram          # A=source, X=VRAM address, Y=length, bank on stack
$82:8138  palette_copy_a       # A=addr, Y=bank: 16 words -> $7E:5508 and $7E:5708
$82:816F  palette_copy_b       # ...the sibling, -> $7E:5608/$7E:5808; never executed
$80:91F7  screen_show_fade     # gfx -> BG3, fade in over 15, hold 128, fade out
$80:9C52  fade_in_start        # zeroes $136C and queues the counting job below
$80:9C63  fade_in_job          # vbl job: INC $136C, dequeues itself at $0F
$80:9C72  fade_out_start       # ...the other direction
$80:9C7D  fade_out_job         # vbl job: DEC $136C, dequeues when it goes negative
$80:9F29  vram_bulk_upload     # queues $80:9ED0 and spins on $C6 until it drains
$82:8163  palette_job_a        # vbl job: queues $82:8308
$82:819A  palette_job_b        # vbl job: DMAs $7E:5608 into CGRAM at index $F0
$82:8209  camera_scroll_job    # vbl job: BG scroll from camera_x/_y
$80:C8DC  hw_multiply          # 16x16 through $211B/$2134; .db, and never executed
$80:C8F6  object_spawner_body  # a thread, spawned at $80:87C1 -- not a subroutine
$82:8014  boss_bg_queue        # a stored 14x20 figure -> 20 bg_dma jobs, one per row
$82:8069  boss_bg_queue_flip   # ...the same, staged through boss_bg_stage and mirrored
$82:81C9  boss_bg_dma          # the vblank job both register: drains bg_dma into $2118
$82:892E  boss_bg_frame        # picks one of four frames, and plain or flipped on $36
$82:895E  boss_bg_frame_table  # 4 far pointers: $97:FD9D and three in bank $83
$82:896E  boss_bg_frame_offset # 4 (dx,dy) pairs; dx negated when $36 is negative

# --- Code: sprite build ------------------------------------------------------
$80:B947  sprite_upload_flush  # vblank job: DMAs queued 16x16 frames, then OAM
$80:B9C7  sprite_cache_age     # stamps every slot's tick to sched_tick-1
$80:B9D6  sprite_frame_tile    # A = frame -> OAM tile number; loads it if absent
$80:BA51  sprite_emit          # metasprite -> OAM entries, unflipped
$80:BABA  sprite_emit_flip_x
$80:BB30  sprite_emit_flip_y
$80:BBA6  sprite_emit_flip_xy
$80:B123  actor_nearest        # X,Y = a point -> the nearest record of id 5/6/$38/1
$80:B379  actor_aligned        # ...and the first of id 5/6/1 within a tile, as a direction
$80:B3F1  actor_snap_to        # X,Y = two records; snaps either axis of X within 1px onto Y
$80:BF1B  actor_notify_box     # tells every visible record inside a rectangle; the blast radius
$80:BC23  oam_buffer_clear     # parks all 128 OAM entries off screen at Y=$E0
$80:BC7F  actor_depth_sort     # one bubble pass over the display list
$80:BCE2  actor_cull           # display list -> visible_actors, by camera window
$80:BD1F  sprite_build_oam     # per-frame pass over visible_actors
$80:BDF3  actor_list_reset     # clears all 32 records and empties the list
$80:BE0C  actor_slot_alloc     # takes a free record and links it in at the head.
                               # Scans the 32 downwards from $7E:1ACA for one with
                               # ACTOR_ACTIVE clear and sets its flags to $0001,
                               # which is the only thing that ever sets that bit.
                               # 80 call sites
$80:BE41  actor_slot_free      # A = record; unlinks it and marks it free -- but
                               # only if ACTOR_THREAD matches sched_cur_task,
                               # which is the game's one ownership check. Zeroes
                               # the flags word, so it is what clears
                               # ACTOR_ACTIVE. 63 call sites
$80:BE8F  actor_collide_notify # X = one record of a touching pair; tells both handlers
$80:BEC9  actor_overlap_pass   # pairwise 16x16 overlap test over visible_actors
$80:F7F7  player_collide       # the player thread's handler; A = the other actor's id
$80:F808  player_collide_table # 57 x u16, indexed by that id x2; targets are bank $80
$80:F87A  player_collide_none  # a bare RTS: the table entry for an id that does nothing
$80:F87B  player_pickup        # ids $0C..$20: adds to player_inventory, caps at $0999
$80:F8AC  pickup_amount_table  # 21 x u16 BCD, indexed by (id - $0C) x 2
$80:F8D6  player_item_pickup   # 13 ids from $21: adds to player_items, caps at $0099
$80:F907  item_amount_table    # 19 x u16 BCD, indexed by (id - $21) x 2
$80:F92D  player_collide_sfx   # id $01: three instructions, all of them a noise
$80:F950  player_collide_hurt  # the entry every collision in level 1 lands on
$81:8888  enemy_collide        # an enemy thread's handler; same argument
$81:8561  enemy_damage_table   # indexed by (id - $5C) x 2; subtracted from health at $1E
$81:8727  enemy_die            # awards $0100 and posts $F5F5 as the thread's death request
$81:8506  enemy_survived_react # splices a JSL frame into the enemy thread's own parked stack
$81:8542  enemy_hurt_flash     # what that frame runs: ACTOR_ATTR_SET for two ticks
$81:8C17  enemy_body_health4   # an actor body whose init is LDA #$0004 : STA $1E
$81:87F8  enemy_body_health0   # ...and level 1's, which is LDA #$0000, so every hit is fatal
$81:B41C  enemy_b41c_collide   # the third copy of enemy_collide; health $0C, no death award
$81:B168  b41c_queue_b16e      # LDA #$B16E : STA $0E — what id $61 does to one on the ground
$81:B16E  b41c_special_react   # swaps the record's metasprite, sleeps $20, re-installs the handler
$81:AEA6  b41c_body            # its actor body; consumes the $4C hit flag at $81:AEC5
$81:CDDE  enemy_cdde_collide   # a fourth handler: no damage table, a plain countdown at $0C
$81:CC0A  cdde_react_begin     # its hurt flash — swaps $16 for $81:CC2F, no stack splice
$81:CC2F  cdde_react_end       # ...and the undo, when the $24 timer reaches zero
$81:CC90  cdde_arm             # countdown $0C = 4, clears $0A/$1E/$20/$24/$28-$2E,
                               # then installs enemy_cdde_collide. Four hits is the
                               # whole of this creature's health; cdde_react_begin
                               # putting it back up to $14 for 30 frames is why
                               # cdde_killed_reacting has no input.
$81:B592  enemy_b592_collide   # 24 bytes; answers ids $07 and $08 and nothing else
$80:F9BE  player_queue_entry   # id $0A: the state gate with $80:DC09's store inlined
$80:F9D0  player_queue_body    # what it queues: costs a point of health, sound $19, $4B ticks
$80:F979  player_hurt_alt      # id $0B: the second kind of hit — event $C000, timer $30
$80:F999  player_state_gate_e331 # id $35: three state tests, then JMP $80:E331. Unported, unreached
$81:9B6B  enemy_9b6b_collide   # level 21's; health $32, id $30, death is DEC $26
$81:9063  enemy_9063_collide   # level 5's; health $22, id $30, death is DEC $2E
$81:F534  actor_f534_collide   # five ids into $3E, two of them guarded on $06 == 4
$83:A264  victim_a264_collide  # victim_collide's sibling; claims via $18/$1E and $7E:605A
$81:8191  a264_flag_set        # STA $7E605A,X — one byte, guarded on the index being $FFFF
$82:DEEB  actor_deeb_collide   # seven bytes: id $FF latches into $12 and parks the thread
$82:F1C2  actor_f1c2_collide   # level 37's; clears its own ACTOR_COLLIDE_ID and DECs $14
$82:F4EF  actor_f4ef_collide   # sixteen bytes: ids $05 and $06 -- the two players and
                               # nothing else -- latch into $18. Never drawn
$82:F3A7  actor_f4ef_seed      # STZ $18, four instructions before it installs the handler
$82:F4C6  actor_f4ef_poll      # LDA $18 : BEQ $F4AF — the body waiting to be stood on
$81:C440  ant_c440_collide # $81:C4A6 one stage earlier: same page, $81:8506 and $81:847E instead
$81:C321  ant_c440_body        # installs it, then JMP $C3B5 into the body that installs $81:C4A6
$81:D7F6  enemy_d7f6_collide   # level 17's; health $0C = 1, $5E kills outright, death is DEC $0A
$82:990F  tentacle_thread      # the bonus levels' purple tentacle: in at a side of the screen,
                               # walk, follow a wall, chase; `src/port/tentacle.h`
$82:9A6D  enemy_9a6d_collide   # $81:D7F6's 64 bytes again, byte for byte; records 0 and 51
$82:AA2E  boss_aa2e_collide    # $82:9660's shape: health $48 = 75, $4C flash, $60 immune, DEC $46 dies
$82:F330  actor_f330_collide   # $5D/$62/$5C/$65 DEC $10 and set carry, $FF sets carry
$81:A638  actor_a638_collide   # $FF DECs $2A and sets carry
$82:84AC  actor_84ac_collide   # only $62: a negative $32 goes back to 4 and DECs $30
$81:B95F  enemy_b95f_collide   # $81:D7F6 with $5D, not $5E, as the fatal id; parked id $5A
$82:EFF0  enemy_eff0_collide   # health $32 with no death test: stored and into $81:8506
$81:C8C3  actor_c8c3_collide   # players and shots set $0A = $C6F2; $68 tallies $1FC4 and turns
$81:C6EC  actor_c8c3_touched   # LDA #$C6F2 : STA $0A : RTS
$81:C6A7  actor_c8c3_face      # $0A = $C6CA, and ACTOR_FLIP's mirror bit toward $0076's X
$81:D6B0  enemy_d7f6_body      # seeds $0C=1 and $0A=0, then registers the handler
$81:D72B  enemy_d7f6_die       # what DEC $0A wakes: award $0050 if $20 is set, then free the slot
$81:EDAA  shot_edaa_collide    # one byte, RTL: the $61 shot reacts to nothing it hits
$81:EDAB  shot_edaa_id_table   # $61's two-player collision ids, immediately after the handler
$80:F8AC  weapon_pickup_amount # how many shots a pickup gives, by inventory slot, in BCD; slot 5 is 5, slot 11 is 20
$81:F6A3  shot_f6a3_collide    # 17 bytes, shared by weapons $63/$64/$66/$67; records $01/$03/$04 at $3E
$81:F6B8  shot_f6a3_id_tables  # five two-word id tables in a row — which is what says four weapons share it
$81:F691  shot_f6a3_install    # STZ $3E, then LDA #$F6A3 : LDY #$0081 : JSL $80:8475
$81:F57B  shot_f6a3_poll       # LDA $3E : BEQ — the shot body reading what its handler recorded
$82:9660  boss_9660_collide    # level 25's boss; 70 health at $3C, four ids remapped before the table
$82:94E4  boss_9660_body       # its thread: four display records, then the handler and the seeds
$82:94B4  boss_9660_alloc_rec  # one of the four, with ACTOR_COLLIDE_ID $03
$82:8F6A  boss_9660_flash      # consumes the $3E hit flag, arms $40 for 3 passes, swaps the palette
$82:95A0  boss_9660_die        # drops the handler, pays $2000, frees four slots, mosaics out
$80:F9AE  player_state_gate    # jump-table entry: returns on states 2 and 4, else JMPs to $DC09
$80:DC09  player_state_tail    # three guards and one store; queues $80:DC1E into $28
$80:DC1E  player_state_next    # what that store queues — unported, and never called from here
$80:D259  player_input_buttons # B -> $EA63, A -> $EAA8, X -> $EAE1; all three edge-detected
$80:EA63  weapon_select_next   # next non-empty player_inventory slot; 14 slots, 15 tries
$80:EAA8  item_select_next     # next non-empty player_items slot; 12 slots, 13 tries
$80:EAE1  item_use             # dispatches the selected item through item_use_table
                              # -- $80:EAEC `LDA $4E : ORA $70 : BNE` refuses it
                              # unless the player is in state 0, so every item
                              # below runs from player_state_normal and returns
                              # to it
$80:EB23  item_slot1_use       # `LDA #$8000 : STA $54` then `LDA #$0352 : STA $56`
                              # -- the *only* site in the cartridge that arms the
                              # player page's $56 from state 0, so it is the only
                              # way psn_t3_expired can be reached. $56 is a
                              # per-state timer everywhere else: states 2, 4 and 6
                              # each arm and decrement their own, and both paths
                              # that end a state do it exactly when $56 hits zero
                              # -- inside that state, never in state 0.
                              # Item slot 1 is collision id $22 = object type $0A

# --- The player state machine ------------------------------------------------
$80:D1EA  player_state_run     # `LDX $70 : JMP ($D1EF,X)`; $70 is the index, x2
$80:81F9  dir_table            # 16 bytes: the d-pad nibble (U8 D4 L2 R1) as a
                              # direction code. $80:81C7 and $80:81D9 are its two
                              # readers, one per port
$80:D250  player_dir_latch     # `LDA $0072,X : STA $24 : BEQ +2 : STA $26`, and
                              # the one place move and aim part company: $24 is
                              # this frame's direction and drives the step
                              # ($80:D4E9, $80:E450), $26 is the last non-zero
                              # one and is what a shot leaves along ($80:ED54)
                              # and what the player is drawn facing ($80:D526,
                              # $80:D743, $80:ECD8). Twin-stick aiming patches
                              # here — see src/twinstick.h
$80:ED30  player_fire          # spends one BCD round, files $30/$32/$26/$0C as
                              # the shot's x/y/direction/side, and thread_spawns
                              # the weapon's own body off the table at $80:ED8C.
                              # $4C is the cooldown that gates it
$80:D1EF  player_state_table   # 8 words: D1FF D2EA D31C D343 D35E D404 D465 D343
$80:D31C  player_state_2       # $56 expires -> STZ $72 : JMP $DB08; never executed
$80:D465  player_state_bubble  # state 6, 390 frames from $80:DC5C. Escape is a
